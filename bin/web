#!/bin/bash

set -euo pipefail

if [ -f "$HOME/websites.yml" ]; then
    url=$(
        yq -r '.[] | "\(.name)\t\(.url)"' "$HOME/websites.yml" |
        fzf --delimiter='\t' --with-nth=1 --accept-nth=2
    )
    [ -n "$url" ] && open "$url"
elif [ -f "$HOME/websites.txt" ]; then
    url=$(fzf < "$HOME/websites.txt")
    [ -n "$url" ] && open "$url"
else
    echo "there is no websites.yml or websites.txt in $HOME" >&2
    exit 1
fi
