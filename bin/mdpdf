#!/usr/bin/env bash

set -euo pipefail

command -v pandoc >/dev/null || { echo "Error: pandoc not installed" >&2; exit 1; }
command -v typst >/dev/null || { echo "Error: typst not installed" >&2; exit 1; }

[[ $# -eq 1 ]] || { echo "Usage: $(basename "$0") <file.md>" >&2; exit 1; }

input="$1"

[[ -f "$input" ]] || { echo "Error: file not found: $input" >&2; exit 1; }

base="$(basename "${input%.*}")"
typst_file="$(mktemp "/tmp/${base}.XXXXXX.typ")"

trap 'rm -f "$typst_file"' EXIT

pandoc "$input" -t typst -o "$typst_file"
typst compile "$typst_file" "${base}.pdf"
